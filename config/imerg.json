{
    "dataset": {
        "name": "GPM IMERG Early Run",
        "product": "3B-HHR-E",
        "version": "V07",
        "format": "GeoTIFF",
        "temporal_resolution_minutes": 30
    },

    "source": {
        "base_url": "https://jsimpsonhttps.pps.eosdis.nasa.gov",
        "directory": "/imerg/gis/early",
        "text_directory": "/text/imerg/gis/early"
    },

    "region": {
        "name": "Bay of Bengal",
        "min_lat": 5.0,
        "max_lat": 25.0,
        "min_lon": 75.0,
        "max_lon": 100.0
    },

    "processing": {
        "scale_factor": 0.1,
        "output_format": "npy"
    }
}